# FastAPI settings
DEBUG=false

# Database URL (required, must use postgresql+asyncpg)
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>

# Redis URL (required, must use redis:// or rediss://)
REDIS_URL=redis://localhost:6379/0

# JWT secrets (required, each at least 32 characters)
ACCESS_SECRET=change_me_access_secret_at_least_32_chars
REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars

# Token lifetime in minutes
ACCESS_TOKEN_EXPIRE_M=15
REFRESH_TOKEN_EXPIRE_M=43200

# Cookie settings
COOKIE_SECURE=true
COOKIE_SAMESITE=strict

# DFS master settings
DFS_MASTER_PUBLIC_BASE_URL=http://127.0.0.1:8000
DFS_CHUNK_SIZE_BYTES=4194304
DFS_MANIFEST_URL_TTL_S=300
DFS_LOCAL_CHUNKS_DIR=storage/chunks
DFS_LOCAL_NODE_NAME=master-local
DFS_REPLICATION_FACTOR=2
DFS_WRITE_QUORUM=2
DFS_STORAGE_TIMEOUT_S=10

# Shared DFS secrets
DFS_CHUNK_URL_SECRET=change_me_dfs_chunk_url_secret_at_least_32_chars
DFS_INTERNAL_TOKEN=change_me_dfs_internal_token_at_least_32_chars

# Storage-node app settings
STORAGE_NODE_NAME=storage-node-1
STORAGE_CHUNKS_DIR=storage-node/chunks
