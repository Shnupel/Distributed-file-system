# Storage node identity and public endpoint
STORAGE_NODE_NAME=storage-node-1
STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:8010

# Local storage path for chunk files
STORAGE_CHUNKS_DIR=storage-node/chunks

# Master service URL and heartbeat cadence
DFS_MASTER_BASE_URL=http://127.0.0.1:8000
DFS_HEARTBEAT_INTERVAL_S=15

# Shared DFS security secrets (must match master service)
DFS_CHUNK_URL_SECRET=change_me_dfs_chunk_url_secret_at_least_32_chars
DFS_INTERNAL_TOKEN=change_me_dfs_internal_token_at_least_32_chars
